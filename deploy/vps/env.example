# ──────────────────────────────────────────────────────────────────────────────
# /etc/condor/secrets.env — read by install-condor.sh and the systemd units.
#
# This file must NEVER be committed. Treat it like SSH private keys (chmod 600,
# root-owned or deploy-user-owned). Rotate on compromise.
# ──────────────────────────────────────────────────────────────────────────────

# ── Trading mode, Fase 1: default PAPER, never live by accident ──
# PAPER_MODE=true means: dry_run observation only, execution_agent is NOT started
# by bootstrap/restart scripts. Dry run is NOT paper fill simulation, there is
# no virtual balance or simulated PnL in Condor. Live needs PAPER_MODE=false
# plus LIVE_TRADING_CONFIRMED=yes, and a separate master decision on capital,
# pair, connector, leverage, and daily loss limit. Those live values are NOT
# set here, they must be decided before any live run.
PAPER_MODE=true
LIVE_TRADING_CONFIRMED=no
CONDOR_ADMIN_USERNAME=admin
PAPER_CONNECTOR=binance_paper_trade
# Risk limits, disetujui master 12:35 WIB 12 Nov 2026, paket konservatif.
# Live kecil diputuskan master 17:06 WIB 12 Nov 2026: modal 20 dolar,
# risk 2 persen per trade, leverage maks 50x, pair dipilih pipeline lewat
# market screener (bukan pair tetap), exchange Gate.io saja yang terbukti
# bisa, Binance diabaikan. Diputuskan master 19:09 WIB 12 Nov 2026,
# setelah Warp gagal di Cue dan Binance tetap 451.
# PERINGATAN: leverage 50x jauh di atas usulan 10x di laporan, risiko
# likuidasi tinggi, SL harus ketat, jangan naikkan posisi di atas notional
# 50 dolar ini. Daily loss limit disetujui master 17:24 WIB 12 Nov 2026:
# 10 persen per hari dari modal 20 dolar, jadi 2 dolar.
MAX_POSITION_SIZE_QUOTE=50
MAX_OPEN_EXECUTORS=1
MAX_DRAWDOWN_PCT=5
SHUTDOWN_DRAWDOWN_PCT=10
STOP_AFTER_FIRST_FILL=true
MAX_DAILY_LOSS_QUOTE=2
DAILY_LOSS_PCT=10
# Take profit: BUKAN env tetap di Condor. Disetujui master 17:31 WIB
# 12 Nov 2026: TP/SL ditentukan Technical Analyst dari support/resistance,
# dengan lantai rasio minimal 1 banding 2, sinyal di bawah itu tidak dieksekusi.
TAKE_PROFIT_PCT=
TAKE_PROFIT_SOURCE=technical_analyst_support_resistance
TAKE_PROFIT_MIN_RR=2
LIVE_CAPITAL_USD=20
RISK_PER_TRADE_PCT=2
MAX_LEVERAGE=50
LIVE_CONNECTOR_ORDER=gate_io_perpetual
LIVE_PAIR_SOURCE=market_screener_pipeline

# ── Telegram bot ────────────────────────────────────────────────
TELEGRAM_TOKEN=
ADMIN_USER_ID=

# ── Model provider, dipakai Hermes dan Condor ───────────────────
# Diputuskan master 17:35 WIB 12 Nov 2026: agentrouter TIDAK dipakai
# lagi karena ada batasan limit, HCNSEC TIDAK dipakai karena terlalu
# lambat. Diputuskan master 17:36 WIB 12 Nov 2026: di Apinex pilih
# model yang ada tulisan free saja.
# Terverifikasi dari kode Condor 12 Nov 2026 (pydantic_ai_client.py):
# Condor support OpenAI juga, bukan hanya Claude, lewat agent_key
# "openai:<model>" + model_base_url.
# Diputuskan master 13 Nov 2026 00:15 WIB: pakai API HCNSEC saja.
# Rute Condor: OpenAI-compatible HCNSEC, base_url
# https://api.hcnsec.cn/v1, model MiniMax-M3.1-Flash.
# Terverifikasi 13 Nov 2026 00:00 WIB: models HTTP 200, 3 model
# (glm-5.3, kimi-k3, MiniMax-M3.1-Flash), chat test MiniMax-M3.1-Flash
# balas OK dalam 9 detik. Apinex tidak dipakai lagi untuk Condor ini.
# Kunci HCNSEC dipegang HAMID lewat jalur aman, jangan lewat chat.
# Wajib tes 1 dry run tick dulu sebelum live.
AGENT_KEY=openai:MiniMax-M3.1-Flash
MODEL_BASE_URL=https://api.hcnsec.cn/v1
OPENAI_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
# agentrouter dan HCNSEC sengaja dihapus dari env aktif, jangan
# dipakai lagi untuk Condor ini.
# ── Model fallback, Fase 2 ──────────────────────────────────────
# Diputuskan master 19:06 WIB 12 Nov 2026: nanti di Condor buat
# sistem fallback buat model cadangan, dengan API dari provider lain.
# Desain di ~/workspace/multi-agent-phase1/FALLBACK-DESIGN.md.
# Condor bawaan TIDAK punya rantai fallback model untuk agent
# (hanya CONSULT_FALLBACK_MODEL untuk consult), jadi ini harus
# dibangun di Fase 2, bukan sekadar env. Rantai yang direncanakan:
# 1 Apinex free/deepseek-v4.1-flash, 2 Crowllm qwen-3.6-plus:free,
# 3 Apinex free/claude-sonnet-4.6. Pindah kalau primary 401/402/429/
# 5xx/timeout, maks 1x coba per model per tick, kalau semua gagal
# agent berhenti, tidak ada trade.
FALLBACK_MODEL_1=openai:qwen-3.6-plus:free
FALLBACK_BASE_URL_1=https://crowllm.com/v1
FALLBACK_API_KEY_1=
FALLBACK_MODEL_2=openai:free/claude-sonnet-4.6
FALLBACK_BASE_URL_2=https://api.apinex.bond/v1
FALLBACK_API_KEY_2=

# ── Hummingbot API auth, three separate secrets in Fase 1 ──────
# HB_API_PASSWORD is API basic auth only. CONFIG_PASSWORD encrypts connector
# credentials. GATEWAY_PASSPHRASE protects Gateway. Never reuse one value.
HB_API_USERNAME=
HB_API_PASSWORD=
CONFIG_PASSWORD=
GATEWAY_PASSPHRASE=
POSTGRES_PASSWORD=
EMQX_DASHBOARD_PASSWORD=

# ── Hummingbot DB ────────────────────────────────────────────────
# Installer builds DATABASE_URL from POSTGRES_PASSWORD. Do not put a
# different password here. Override only if the DB is remote.
DATABASE_URL=postgresql+asyncpg://hbot:POSTGRES_PASSWORD@localhost:5432/hummingbot_api
BROKER_HOST=localhost
BROKER_USERNAME=
BROKER_PASSWORD=

# ── Tailscale ────────────────────────────────────────────────────
# Reuse the same client ID across deployments so acls stay sane.
TAILSCALE_AUTH_KEY=
TAILSCALE_HOSTNAME=condor-prod-1

# ── Web dashboard ────────────────────────────────────────────────
WEB_URL=http://localhost:8088
WEB_PORT=8088

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
