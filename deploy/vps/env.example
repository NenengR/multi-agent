# ──────────────────────────────────────────────────────────────────────────────
# /etc/condor/secrets.env — read by install-condor.sh and the systemd units.
#
# This file must NEVER be committed. Treat it like SSH private keys (chmod 600,
# root-owned or deploy-user-owned). Rotate on compromise.
# ──────────────────────────────────────────────────────────────────────────────

# ── Trading mode, Fase 1: default PAPER, never live by accident ──
# PAPER_MODE=true means: dry_run observation only, execution_agent is NOT started
# by bootstrap/restart scripts. Dry run is NOT paper fill simulation, there is
# no virtual balance or simulated PnL in Condor. Live needs PAPER_MODE=false
# plus LIVE_TRADING_CONFIRMED=yes, and a separate master decision on capital,
# pair, connector, leverage, and daily loss limit. Those live values are NOT
# set here, they must be decided before any live run.
PAPER_MODE=true
LIVE_TRADING_CONFIRMED=no
CONDOR_ADMIN_USERNAME=admin
PAPER_CONNECTOR=binance_paper_trade
# Risk limits, disetujui master 12:35 WIB 12 Nov 2026, paket konservatif.
# MAX_DAILY_LOSS_QUOTE masih kosong, angkanya belum diputuskan.
# RISK_PER_TRADE_PCT dan MAX_LEVERAGE diusulkan 2 persen dan 10x di laporan,
# belum dijadikan env aktif sampai master konfirmasi.
MAX_POSITION_SIZE_QUOTE=50
MAX_OPEN_EXECUTORS=1
MAX_DRAWDOWN_PCT=5
SHUTDOWN_DRAWDOWN_PCT=10
STOP_AFTER_FIRST_FILL=true
MAX_DAILY_LOSS_QUOTE=

# ── Telegram bot ────────────────────────────────────────────────
TELEGRAM_TOKEN=
ADMIN_USER_ID=

# ── Anthropic / agentrouter provider ────────────────────────────
ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_MODEL=claude-opus-4-8
# Rotate up to 5 keys through this pool. ANTHROPIC_API_KEY is the initial key.
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_AGENTROUTER_1=
ANTHROPIC_API_KEY_AGENTROUTER_1_NOTE=
ANTHROPIC_API_KEY_AGENTROUTER_2=
ANTHROPIC_API_KEY_AGENTROUTER_2_NOTE=
ANTHROPIC_API_KEY_AGENTROUTER_3=
ANTHROPIC_API_KEY_AGENTROUTER_3_NOTE=
ANTHROPIC_API_KEY_AGENTROUTER_4=
ANTHROPIC_API_KEY_AGENTROUTER_4_NOTE=
ANTHROPIC_API_KEY_AGENTROUTER_5=
ANTHROPIC_API_KEY_AGENTROUTER_5_NOTE=

# ── HCNSEC provider (used by agent_key: claude-code:hcnsec) ────
ANTHROPIC_API_KEY_HCNSEC=
ANTHROPIC_BASE_URL_HCNSEC=
ANTHROPIC_MODEL_HCNSEC=

# ── Hummingbot API auth, three separate secrets in Fase 1 ──────
# HB_API_PASSWORD is API basic auth only. CONFIG_PASSWORD encrypts connector
# credentials. GATEWAY_PASSPHRASE protects Gateway. Never reuse one value.
HB_API_USERNAME=
HB_API_PASSWORD=
CONFIG_PASSWORD=
GATEWAY_PASSPHRASE=
POSTGRES_PASSWORD=
EMQX_DASHBOARD_PASSWORD=

# ── Hummingbot DB ────────────────────────────────────────────────
# Installer builds DATABASE_URL from POSTGRES_PASSWORD. Do not put a
# different password here. Override only if the DB is remote.
DATABASE_URL=postgresql+asyncpg://hbot:POSTGRES_PASSWORD@localhost:5432/hummingbot_api
BROKER_HOST=localhost
BROKER_USERNAME=
BROKER_PASSWORD=

# ── Tailscale ────────────────────────────────────────────────────
# Reuse the same client ID across deployments so acls stay sane.
TAILSCALE_AUTH_KEY=
TAILSCALE_HOSTNAME=condor-prod-1

# ── Web dashboard ────────────────────────────────────────────────
WEB_URL=http://localhost:8088
WEB_PORT=8088

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
